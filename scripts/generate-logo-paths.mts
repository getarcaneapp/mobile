// Regenerates src/ui/components/arcane-logo-paths.ts from assets/brand/logo-animated.svg.
// Port of `LaunchLogoPaths` (LaunchLogoPaths.swift): the SVG's pieces in trace
// order, with each piece's outline length precomputed so the trace can trim the
// stroke with a dash offset (react-native-svg has no `pathLength`).
//
//   node scripts/generate-logo-paths.mts

import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const svg = readFileSync(join(root, 'assets/brand/logo-animated.svg'), 'utf8');

const viewBox = (/viewBox="([^"]+)"/.exec(svg)?.[1] ?? '0 0 0 0').split(/\s+/).map(Number);
const translate = (/translate\(([^)]+)\)/.exec(svg)?.[1] ?? '0,0').split(/[\s,]+/).map(Number);

type Point = [number, number];

const dist = (a: Point, b: Point) => Math.hypot(b[0] - a[0], b[1] - a[1]);

function cubicLength(p0: Point, p1: Point, p2: Point, p3: Point) {
	let length = 0;
	let prev = p0;
	for (let i = 1; i <= 64; i++) {
		const t = i / 64;
		const mt = 1 - t;
		const at = (k: 0 | 1) =>
			mt * mt * mt * p0[k] + 3 * mt * mt * t * p1[k] + 3 * mt * t * t * p2[k] + t * t * t * p3[k];
		const point: Point = [at(0), at(1)];
		length += dist(prev, point);
		prev = point;
	}
	return length;
}

/** Same command subset as `LaunchLogoPaths.parsePath`. Returns the outline length. */
function pathLength(data: string) {
	const tokens = data.match(/[MmLlHhVvCcZz]|-?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?/g) ?? [];
	let current: Point = [0, 0];
	let start: Point = [0, 0];
	let command = 'M';
	let index = 0;
	let length = 0;
	const num = () => Number(tokens[index++]);
	const isNumber = () => index < tokens.length && !/[A-Za-z]/.test(tokens[index] ?? '');
	while (index < tokens.length) {
		if (/[A-Za-z]/.test(tokens[index] ?? '')) command = tokens[index++] ?? command;
		const rel = command === command.toLowerCase();
		switch (command.toUpperCase()) {
			case 'M': {
				const x = num();
				const y = num();
				current = rel ? [current[0] + x, current[1] + y] : [x, y];
				start = current;
				while (isNumber()) {
					const lx = num();
					const ly = num();
					const next: Point = rel ? [current[0] + lx, current[1] + ly] : [lx, ly];
					length += dist(current, next);
					current = next;
				}
				break;
			}
			case 'L': {
				const x = num();
				const y = num();
				const next: Point = rel ? [current[0] + x, current[1] + y] : [x, y];
				length += dist(current, next);
				current = next;
				break;
			}
			case 'H': {
				const x = num();
				const next: Point = [rel ? current[0] + x : x, current[1]];
				length += dist(current, next);
				current = next;
				break;
			}
			case 'V': {
				const y = num();
				const next: Point = [current[0], rel ? current[1] + y : y];
				length += dist(current, next);
				current = next;
				break;
			}
			case 'C': {
				const [x1, y1, x2, y2, x, y] = [num(), num(), num(), num(), num(), num()];
				const o: Point = rel ? current : [0, 0];
				const c1: Point = [o[0] + x1, o[1] + y1];
				const c2: Point = [o[0] + x2, o[1] + y2];
				const end: Point = [o[0] + x, o[1] + y];
				length += cubicLength(current, c1, c2, end);
				current = end;
				break;
			}
			case 'Z':
				length += dist(current, start);
				current = start;
				break;
			default:
				throw new Error(`Unsupported command ${command}`);
		}
	}
	return length;
}

const pieces: { d: string; order: number; length: number }[] = [];
for (const element of svg.match(/<(?:path|polygon)\b[^>]*>/g) ?? []) {
	let d = /\bd="([^"]+)"/.exec(element)?.[1];
	if (!d) {
		const points = /\bpoints="([^"]+)"/.exec(element)?.[1];
		if (!points) continue;
		const values = points
			.trim()
			.split(/[\s,]+/)
			.map(Number);
		d =
			`M ${values[0]},${values[1]} ` +
			values.slice(2).reduce((acc, v, i) => acc + (i % 2 === 0 ? `L ${v},` : `${v} `), '') +
			'Z';
	}
	const order = Number(/--i:\s*(\d+)/.exec(element)?.[1] ?? pieces.length);
	pieces.push({ d: d.trim(), order, length: Math.round(pathLength(d) * 100) / 100 });
}
pieces.sort((a, b) => a.order - b.order);

const out = `// Generated by scripts/generate-logo-paths.mts from assets/brand/logo-animated.svg. Do not edit.

/** Port of \`LaunchLogoPaths\`: the logo outline, one traced piece per entry in drawing order. */
export const ArcaneLogoPaths = {
  /** viewBox width/height. */
  width: ${viewBox[2]},
  height: ${viewBox[3]},
  /** The pieces sit inside one translated group. */
  translateX: ${translate[0]},
  translateY: ${translate[1]},
  pieces: [
${pieces.map((p) => `    { order: ${p.order}, length: ${p.length}, d: ${JSON.stringify(p.d)} },`).join('\n')}
  ],
} as const;

export type ArcaneLogoPiece = (typeof ArcaneLogoPaths.pieces)[number];
`;
writeFileSync(join(root, 'src/ui/components/arcane-logo-paths.ts'), out);
console.log(`Wrote ${pieces.length} pieces`);
