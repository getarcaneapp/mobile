{
	"cli": {
		"version": ">= 25.0.0",
		"appVersionSource": "local"
	},
	"build": {
		"beta": {
			"distribution": "store",
			"environment": "production",
			"env": {
				"EXPO_NO_GIT_STATUS": "1"
			},
			"ios": {
				"buildConfiguration": "Release"
			},
			"android": {
				"buildType": "app-bundle"
			}
		},
		"github": {
			"extends": "beta",
			"node": "26.7.0",
			"pnpm": "12.14.0",
			"env": {
				"EXPO_NO_GIT_STATUS": "1",
				"EAS_USE_CACHE": "1"
			},
			"android": {
				"buildType": "apk"
			}
		}
	},
	"submit": {
		"internal": {
			"ios": {
				"ascAppId": "6767286199"
			},
			"android": {
				"track": "internal",
				"releaseStatus": "completed"
			}
		}
	}
}
