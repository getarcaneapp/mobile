{
	"cli": {
		"version": ">= 25.0.0",
		"appVersionSource": "local"
	},
	"build": {
		"beta": {
			"distribution": "store",
			"env": {
				"EXPO_NO_GIT_STATUS": "1"
			},
			"ios": {
				"buildConfiguration": "Release"
			},
			"android": {
				"buildType": "app-bundle"
			}
		}
	},
	"submit": {
		"internal": {
			"ios": {
				"ascAppId": "6767286199"
			},
			"android": {
				"track": "internal",
				"releaseStatus": "completed"
			}
		}
	}
}
